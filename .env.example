# Database Configuration
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/ems?schema=public"

# Authentication Secrets
JWT_SECRET="your-32-character-secret-key-change-this-in-production"
ENCRYPT_KEY="your-32-character-encryption-key-change-this"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# reCAPTCHA Configuration (Optional - for bot prevention)
# Get keys from: https://www.google.com/recaptcha/admin
# Choose reCAPTCHA v2 ("I'm not a robot" Checkbox)
# Add localhost to authorized domains
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"

# Email Configuration (Optional - for email verification)
# For Gmail: Enable "Less secure app access" or use App Password
EMAIL_SERVICE="gmail"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="noreply@ems.com"

# Node Environment
NODE_ENV="development"
