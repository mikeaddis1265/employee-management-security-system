generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id @default(uuid())
  username          String        @unique
  email             String        @unique
  hashedPassword    String
  role              Role          @default(EMPLOYEE)
  department        String
  securityLevel     SecurityLevel @default(PUBLIC)
  mfaSecret         String?
  mfaEnabled        Boolean       @default(false)
  emailVerified     Boolean       @default(false)
  verificationToken String?
  isLocked          Boolean       @default(false)
  failedAttempts    Int           @default(0)
  lastFailedLogin   DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  resources       Resource[]
  permissions     Permission[]
  grantedPerms    Permission[]       @relation("GrantedBy")
  logs            Log[]
  auditTrail      AuditTrail[]
  payrollRecords  PayrollRecord[]
  payrollApproved PayrollRecord[]    @relation("PayrollApprover")
  attendance      Attendance[]
  leaveRequests   LeaveRequest[]     @relation("Employee")
  approvedLeaves  LeaveRequest[]     @relation("Approver")
  documents       EmployeeDocument[]

  @@map("users")
}

model Resource {
  id               Int           @id @default(autoincrement())
  name             String
  ownerId          String
  sensitivityLevel SecurityLevel
  content          Json?
  description      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  permissions Permission[]

  @@map("resources")
}

model Permission {
  id             Int            @id @default(autoincrement())
  resourceId     Int
  userId         String
  permissionType PermissionType
  grantedById    String?
  grantedAt      DateTime       @default(now())

  resource  Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?    @relation("GrantedBy", fields: [grantedById], references: [id])

  @@unique([resourceId, userId, permissionType])
  @@map("permissions")
}

model RoleDef {
  roleName    String @id
  permissions Json

  @@map("roles")
}

model Log {
  id        Int      @id @default(autoincrement())
  userId    String?
  username  String
  timestamp DateTime @default(now())
  ip        String?
  action    String
  details   String
  encrypted Boolean  @default(true)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("logs")
}

model AuditTrail {
  id        Int      @id @default(autoincrement())
  userId    String
  action    String
  timestamp DateTime @default(now())
  details   String
  metadata  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_trail")
}

enum Role {
  EMPLOYEE
  MANAGER
  HR
  ADMIN
}

enum SecurityLevel {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
}

enum PermissionType {
  READ
  WRITE
}

model PayrollRecord {
  id              Int      @id @default(autoincrement())
  employeeId      String
  month           Int
  year            Int
  baseSalary      Float
  overtime        Float    @default(0)
  deductions      Float    @default(0)
  netSalary       Float
  status          String   @default("pending")
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee  User  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("PayrollApprover", fields: [approvedById], references: [id])

  @@unique([employeeId, month, year])
  @@map("payroll_records")
}

model Attendance {
  id          Int       @id @default(autoincrement())
  employeeId  String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      String    @default("present")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("attendance")
}

model LeaveRequest {
  id               Int       @id @default(autoincrement())
  employeeId       String
  leaveType        String
  startDate        DateTime
  endDate          DateTime
  days             Int
  reason           String
  status           String    @default("pending")
  approvedById     String?
  approvedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee   User  @relation("Employee", fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("Approver", fields: [approvedById], references: [id])

  @@map("leave_requests")
}

model EmployeeDocument {
  id          Int      @id @default(autoincrement())
  employeeId  String
  documentType String
  fileName    String
  filePath    String
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_documents")
}

model SystemSettings {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}
